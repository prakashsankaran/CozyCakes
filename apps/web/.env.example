# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL connection string (local Docker, Neon or Supabase)
# (`docker compose up -d` at the repo root gives you this one; on Vercel it is set by Neon)
DATABASE_URL=postgres://cozy:cozy@localhost:5432/cozycakes

# Public URL of the site, used for links in emails and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CozyCakes Instagram handle, used for "message me" links
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/cosycaker

# Cloudinary account for cake photos and reference photo uploads:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
# (optional; without it the builder's photo step points customers to Instagram and the back office
# cannot upload cake photos)
# CLOUDINARY_URL=

# Back office (/admin). Email addresses that sign in as the owner, comma separated.
# OWNER_EMAIL=you@example.com

# Resend API key for sign-in codes and, later, order emails. Without it, sign-in codes can only be
# delivered through MAIL_OUTBOX_DIR below.
# RESEND_API_KEY=
# Sender address; defaults to Resend's shared test sender, which can only email your own address.
# EMAIL_FROM=CozyCakes <hello@your-domain.in>

# Local development and tests only: write emails as JSON files to this folder instead of sending.
# MAIL_OUTBOX_DIR=.outbox

# Optional: secret for signing sessions. When unset it is derived from DATABASE_URL.
# BETTER_AUTH_SECRET=

# Online checkout (Razorpay). Checkout only appears when both keys are set; otherwise the cart
# sends orders on Instagram. On Vercel, set these for Production only (previews share the database).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Secret of the webhook for https://<site>/api/webhooks/razorpay (event payment.captured)
# RAZORPAY_WEBHOOK_SECRET=

# Local development and tests only: a fake payment window instead of Razorpay.
# PAYMENT_PROVIDER=test

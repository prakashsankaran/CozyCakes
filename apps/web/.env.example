# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL connection string (local Docker, Neon or Supabase)
# (`docker compose up -d` at the repo root gives you this one; on Vercel it is set by Neon)
DATABASE_URL=postgres://cozy:cozy@localhost:5432/cozycakes

# Public URL of the site, used for links in emails and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CozyCakes Instagram handle, used for "message me" links
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/cosycaker

# Cloudinary account for reference photo uploads: cloudinary://<api_key>:<api_secret>@<cloud_name>
# (optional; without it the builder's photo step points customers to Instagram)
# CLOUDINARY_URL=

# Added in later phases (see specs/001-cozycakes-storefront/plan.md):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RESEND_API_KEY=
# BETTER_AUTH_SECRET=
